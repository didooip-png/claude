# Images des questions uniquement : aucun script ne peut s'exécuter ici.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'"
</IfModule>
